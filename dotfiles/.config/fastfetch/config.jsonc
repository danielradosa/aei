{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch",
    "color": {
      "1": "35",
      "2": "33"
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys":   "33",
      "title":  "35"
    }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os",      "key": " os     " },
    { "type": "kernel",  "key": "󰒔 kernel " },
    { "type": "shell",   "key": " shell  " },
    { "type": "wm",      "key": "󱂬 wm     " },
    { "type": "uptime",  "key": "󰅐 uptime ", "format": "{days}d {hours}h {minutes}m" },
    "break",
    { "type": "cpu",     "key": "󰻠 cpu    ", "showPeCoreCount": false },
    { "type": "gpu",     "key": "󰍛 gpu    ", "detectionMethod": "pci" },
    { "type": "memory",  "key": "󰾆 ram    " },
    { "type": "disk",    "key": "󰋊 disk   ", "folders": "/" },
    "break",
    { "type": "terminal","key": " term   " },
    { "type": "font",    "key": "󰛖 font   ", "format": "{name} {size}" },
    { "type": "theme",   "key": " theme  " },
    { "type": "colors",  "block": { "width": 2, "height": 1 }, "paddingLeft": 1 }
  ]
}
