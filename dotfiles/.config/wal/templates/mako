default-timeout=3000
ignore-timeout=0

font=JetBrains Mono 11
width=320
height=100
margin=10
padding=12
border-size=2
border-radius=8
icons=1
max-icon-size=36
markup=1
actions=1
sort=-time
max-visible=5

background-color={color0}f0
text-color={color7}
border-color={color5}99
progress-color=over {color10}55

[urgency=low]
background-color={color0}cc
border-color={color8}55
text-color={color6}
default-timeout=3000

[urgency=normal]
background-color={color0}f0
border-color={color5}99
default-timeout=3000

[urgency=high]
background-color={color1}ee
border-color={color9}ff
text-color={color7}
default-timeout=0
